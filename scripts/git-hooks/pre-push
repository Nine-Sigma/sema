#!/usr/bin/env bash
# Scan every commit a push would publish: its diff and its message.
set -euo pipefail
zero=0000000000000000000000000000000000000000
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    bash "$(dirname "$0")/scan-sensitive.sh" range "$local_sha" --not --remotes
  else
    bash "$(dirname "$0")/scan-sensitive.sh" range "$remote_sha..$local_sha"
  fi
done
