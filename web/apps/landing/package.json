{
  "name": "@sema/landing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && npm run copy:check && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "copy:md": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/render-copy.ts",
    "copy:check": "node --disable-warning=ExperimentalWarning --experimental-strip-types scripts/render-copy.ts --check"
  },
  "dependencies": {
    "@sema/design": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
